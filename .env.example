# ── CricketCommander environment ──────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your own values.

# Google Gemini API key — powers the Stats, Banter, and Predictor agents.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Upstash Redis (REST) — stores agent events, match header, predictor
# accuracy, and the live viewer count. Create a free DB at https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cricbuzz match id to follow. If omitted or unrecognized, the app
# replays the bundled fixture as a simulated live innings (demo mode).
# MATCH_ID=152252
